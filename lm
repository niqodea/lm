def _add_thread_args(parser: argparse.ArgumentParser, *, required: bool) -> None:
    group = parser.add_mutually_exclusive_group(required=required)
    group.add_argument(
        "-t",
        "--thread",
        help="Thread name.",
    )
    group.add_argument(
        "-l",
        "--last",
        action="store_true",
        help="Use the last active thread.",
    )
    group.add_argument(
        "-s",
        "--select",
        action="store_true",
        help="Pick a thread interactively.",
    )


def _has_thread_arg(args: argparse.Namespace) -> bool:
    return args.thread is not None or args.last is True or args.select is True


@dataclass(frozen=True)
class _Thread:
    """A thread directory, and where everything sits inside it."""

    path: Path

    @property
    def name(self) -> str:
        return self.path.name

    @property
    def editmsg_path(self) -> Path:
        return self.path / ".EDITMSG.md"

    @property
    def staged_path(self) -> Path:
        return self.path / "STAGED"

    @property
    def claude_path(self) -> Path:
        return self.path / ".claude"

    @property
    def model_path(self) -> Path:
        return self.claude_path / "model"

    @property
    def tools_path(self) -> Path:
        return self.claude_path / "tools"

    @property
    def session_path(self) -> Path:
        return self.claude_path / "session.jsonl"

    @property
    def scratch_cwd_path(self) -> Path:
        return self.claude_path / "scratch-cwd"

    def get_turn_path(self, idx: int) -> Path:
        return self.path / f"{idx:02d}"


class _Exchanges:
    """The files of one prompt, before and after it is sent."""

    @dataclass(frozen=True)
    class _Base:
        """What a query and a turn hold alike."""

        path: Path

        @property
        def prompt_path(self) -> Path:
            return self.path / "prompt.md"

        @property
        def stdin_path(self) -> Path:
            return self.path / "stdin"

        @property
        def attachments_path(self) -> Path:
            return self.path / "attachments"

    @dataclass(frozen=True)
    class Query(_Base):
        """Staged, not sent yet."""

    @dataclass(frozen=True)
    class Turn(_Base):
        """Sent, with the response saved beside it."""

        @property
        def response_path(self) -> Path:
            return self.path / "response.md"


def _get_thread(args: argparse.Namespace, threads_path: Path) -> _Thread:
    if isinstance(args.thread, str):
        thread_name = args.thread
    elif args.last is True:
        threads = _get_threads(threads_path)
        if not threads:
            sys.exit("No threads found.")
        thread_name = threads[0].name
    elif args.select is True:
        thread_name = _select_thread(threads_path)
    else:
        raise RuntimeError("Thread not in arguments.")

    _assert_thread_name_is_valid(thread_name)

    path = threads_path / thread_name

    _assert_thread_exists(path)

    return _Thread(path)


def _select_thread(threads_path: Path) -> str:
    threads = _get_threads(threads_path)
    if not threads:
        sys.exit("No threads found.")

    summary_to_name = {
        _format_thread_summary_line(thread): thread.name for thread in threads
    }

    result = subprocess.run(
        ["fzf", "--no-sort"],  # noqa: S607  (we expect path variable to be safe)
        input="\n".join(summary_to_name),
        stdout=subprocess.PIPE,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        sys.exit("No thread selected.")

    return summary_to_name[result.stdout.rstrip("\n")]


def _get_threads(threads_path: Path) -> list[_Thread]:
    paths = sorted(
        (p for p in threads_path.iterdir() if p.is_dir()),
        # NOTE: Not a super robust way to sort by last activity, but simple and works
        key=lambda p: p.stat().st_mtime,
        reverse=True,
    )
    return [_Thread(p) for p in paths]


def _resolve_thread_and_prompt(
    args: argparse.Namespace, threads_path: Path, *, draft: str | None
) -> tuple[_Thread, str]:
    if _has_thread_arg(args):
        thread = _get_thread(args, threads_path)
        _assert_no_staged_query(thread)
        history = _build_history(thread)
        return thread, _edit_prompt(thread.editmsg_path, history=history, draft=draft)

    thread_timestamp = datetime.datetime.now().astimezone().strftime("%Y%m%d-%H%M%S")
    editmsg_pathname = TIMESTAMP_EDITMSG_PATHNAME_TEMPLATE.format(
        timestamp=thread_timestamp
    )
    # The thread is written only once there is a prompt for it, so abandoning
    # the editor leaves no empty thread behind
    prompt = _edit_prompt(threads_path / editmsg_pathname, history=[], draft=draft)

    sys.stderr.write(f"Creating new thread: {thread_timestamp}\n")
    thread = _create_thread(
        threads_path / thread_timestamp,
        claude_model=DEFAULT_CLAUDE_MODEL,
        claude_tools="",
    )
    return thread, prompt


class _EmptyPromptError(Exception):
    """The editor came back with nothing."""


def _edit_prompt(
    path: Path, *, history: list[tuple[str, list[str], str]], draft: str | None
) -> str:
    editor_command = shlex.split(os.getenv("EDITOR", "vim"))
    if not editor_command:
        sys.exit("Editor is empty.")

    editor_name = Path(editor_command[0]).name

    prompt_is_last = editor_name in PROMPT_IS_LAST_EDITORS

    if prompt_is_last:
        editor_command.append("+$")
        scissors_line_component = (
            "<!-- Everything above this scissors line will be ignored. -->\n"
            f"{SCISSORS_LINE}\n"
        )
    else:
        scissors_line_component = (
            f"{SCISSORS_LINE}\n"
            "<!-- Everything below this scissors line will be ignored. -->\n"
        )

    if editor_name in INSERT_MODE_EDITORS and draft is None:
        # Immediately open in insert mode, pressing 'i' adds real friction!
        editor_command.append("+startinsert")

    components: list[str] = []

    components.extend(_format_history(history))

    if components:
        components.append(scissors_line_component)

    if draft is not None:
        components.append(draft)
    else:
        # drafts come with trailing newline, add it to empty string for consistency
        components.append("\n")

    if not prompt_is_last:
        components.reverse()

    path.write_text("\n\n".join(components))

    tty_path = Path(os.getenv(LM_TTY_ENV, "/dev/tty"))

    with tty_path.open("r") as tty_in, tty_path.open("w") as tty_out:
        process_result = subprocess.run(  # noqa: S603  (running the user editor expected to be safe)
            [*editor_command, str(path)],
            check=False,
            # For piping stdin
            stdin=tty_in,
            # For piping stdout
            stdout=tty_out,
            stderr=tty_out,
        )

    if process_result.returncode != 0:
        sys.exit("Editor exited with an error.")

    editmsg_fragments = path.read_text().split(f"\n{SCISSORS_LINE}\n")
    path.unlink()

    prompt_fragment = editmsg_fragments[-1] if prompt_is_last else editmsg_fragments[0]
    prompt = prompt_fragment.strip()

    if prompt == "":
        raise _EmptyPromptError

    return prompt


def _format_history(history: list[tuple[str, list[str], str]]) -> list[str]:
    components: list[str] = []
    for turn_idx, (turn_prompt, turn_attachments, turn_response) in enumerate(history):
        prompt_component = f"<!-- Prompt {turn_idx + 1} -->\n\n{turn_prompt}"
        if len(turn_attachments) > 0:
            attachments_section = f"\nAttachments: {', '.join(turn_attachments)}"
            prompt_component += attachments_section
        response_component = f"<!-- Answer {turn_idx + 1} -->\n\n{turn_response}"

        components.append(prompt_component)
        components.append(response_component)
    return components


def _execute_turn(
    thread: _Thread,
    *,
    prompt: str,
    piped_stdin: str,
    attachments_path: Path | None,
    char_delay: float,
) -> str:
    prompt_summary = _summarize_text(prompt, max_length=PROMPT_SUMMARY_MAX_LENGTH)
    claude_tools = thread.tools_path.read_text()

    with _ClaudeContext.create(
        session_path=thread.session_path,
        scratch_cwd_path=thread.scratch_cwd_path,
        attachments_path=attachments_path,
    ) as (claude_session_args, claude_attachments_prompt):
        claude_prompt = (
            prompt
            if claude_attachments_prompt is None
            else f"{prompt}\n\n{claude_attachments_prompt}"
        )

        command = [
            "claude",
            claude_prompt,
            "--model",
            thread.model_path.read_text(),
            *claude_session_args,
            # Simplify behavior
            "--system-prompt",
            SYSTEM_PROMPT,
            "--print",
            # Restrict tool context
            "--tools",
            claude_tools,
            # Pre-approve to avoid permission errors in print mode
            "--allowed-tools",
            claude_tools,
            # To stream response text
            "--include-partial-messages",
            "--output-format",
            "stream-json",
            "--verbose",
        ]

        process = subprocess.Popen(  # noqa: S603  (command is not user-provided)
            command,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            text=True,
            # --bare / CLAUDE_CODE_SIMPLE disables OAuth and routes billing to API
            # Still, as long as we set CWD to a bare directory, no CLAUDE.md will be
            # picked up.
            cwd=thread.scratch_cwd_path,
        )

        if process.stdin is None:
            sys.exit("Unexpected error: Claude standard input not captured")

        process.stdin.write(piped_stdin)
        process.stdin.close()

        # Clear screen, helps keeping text stationary as it streams.
        sys.stderr.write("\033[2J\033[H")
        sys.stderr.write(f"Running prompt: {prompt_summary}\n\n")
        sys.stderr.flush()

        return _read_response(process, thread_name=thread.name, char_delay=char_delay)


def _read_response(
    process: subprocess.Popen[str], *, thread_name: str, char_delay: float
) -> str:
    if process.stdout is None:
        sys.exit("Unexpected error: Claude standard output not captured")

    buffer = io.StringIO()
    for line in process.stdout:
        event = json.loads(line)

        # The result event ends the run, and says whether the turn succeeded.
        # is_error is in the CLI's own result schema, not the published docs:
        # false on the success variant, true on every error one.
        if event["type"] == "result":
            if event.get("is_error") is True:
                sys.exit(
                    _format_inference_failure(
                        detail=_get_failure_detail(
                            errors=event.get("errors", []),
                            error_subtype=event.get("subtype"),
                        ),
                        thread_name=thread_name,
                    )
                )
            buffer.write("\n")
            sys.stdout.write("\n")
            return buffer.getvalue()

        if event["type"] != "stream_event":
            continue
        if event["event"]["type"] != "content_block_delta":
            continue
        if event["event"]["delta"]["type"] != "text_delta":
            continue
        text = event["event"]["delta"]["text"]

        buffer.write(text)

        if char_delay == 0.0:
            sys.stdout.write(text)
            sys.stdout.flush()
        else:
            for char in text:
                sys.stdout.write(char)
                sys.stdout.flush()
                time.sleep(char_delay)

    # Every result event returns or exits, so the stream ended without one.
    process.wait()
    sys.exit(
        _format_inference_failure(
            detail=f"claude exited {process.returncode} without reporting a result",
            thread_name=thread_name,
        )
    )


def _get_failure_detail(*, errors: list[str], error_subtype: str | None) -> str:
    # `errors` is in the CLI result schema, though not in the published docs
    if len(errors) > 0:
        return "; ".join(errors)
    if error_subtype is None:
        return "error result with no subtype"
    description = CLAUDE_ERROR_SUBTYPE_REASONS.get(error_subtype, "unknown error")
    return f"{description} ({error_subtype})"


def _format_inference_failure(*, detail: str, thread_name: str) -> str:
    return (
        f"Inference failed: {detail}.\n"
        "Your query is still staged.\n"
        f"  Retry with:      lm commit -t {thread_name}\n"
        f"  Discard it with: lm clear -t {thread_name}"
    )


def _get_turns_count(thread: _Thread) -> int:
    idx = 0
    while thread.get_turn_path(idx).exists():
        idx += 1
    return idx


def _get_preset(name: str, config_path: Path) -> str:
    presets_path = config_path / PRESETS_PATHNAME
    path = presets_path / f"{name}.md"
    if not path.exists():
        sys.exit(f"Preset not found: {path}")
    return path.read_text()


def _get_attachment(arg: str) -> tuple[Path, str]:
    if ":" not in arg:
        path = Path(arg)
        alias = path.name
    else:
        path_str, alias = arg.rsplit(":", 1)
        path = Path(path_str)
    if not alias:
        sys.exit(f"Attachment alias is empty: {arg}")
    if not path.exists():
        sys.exit(f"Attachment not found: {path}")
    if path.is_dir():
        sys.exit(f"Attachment is a directory: {path}")
    if path.stat().st_size > ATTACHMENT_MAX_SIZE_BYTES:
        sys.exit(f"Attachment too large: {path}")
    return path, alias


def _write_prompt(query: _Exchanges.Query, prompt: str) -> None:
    # new line at the end to be in line with response and stick to best practices
    query.prompt_path.write_text(f"{prompt}\n")


def _write_attachments(attachments: list[tuple[Path, str]], path: Path) -> None:
    for source_path, alias in attachments:
        alias_path = path / alias
        if alias_path.exists():
            sys.exit(f"Attachment already exists with alias '{alias}'")
        source_path.copy(alias_path)


def _summarize_text(value: str, *, max_length: int) -> str:
    return _compress_text(" ".join(value.split()), max_length=max_length)


def _compress_text(value: str, max_length: int) -> str:
    if len(value) <= max_length:
        return value
    left = max_length // 2
    right = max_length - left - 3
    return f"{value[:left]}...{value[-right:]}"


def _build_history(thread: _Thread) -> list[tuple[str, list[str], str]]:
    entries: list[tuple[str, list[str], str]] = []
    for idx in range(_get_turns_count(thread)):
        turn = _Exchanges.Turn(thread.get_turn_path(idx))
        prompt = turn.prompt_path.read_text()
        attachments_path = turn.attachments_path
        if attachments_path.exists():
            attachments = [p.name for p in attachments_path.iterdir()]
        else:
            attachments = []
        response = turn.response_path.read_text()
        entries.append((prompt, attachments, response))
    return entries


def _get_char_delay_from_settings(config_path: Path) -> float:
    settings_path = config_path / SETTINGS_PATHNAME
    settings = tomllib.loads(settings_path.read_text())
    char_delay = settings.get(SETTINGS_CHAR_DELAY_KEY, 0.0)
    if not isinstance(char_delay, float):
        sys.exit(f"Setting {SETTINGS_CHAR_DELAY_KEY} must be a float: {char_delay}")
    return char_delay


def _get_config_path(*, missing_ok: bool) -> Path:
    if (xdg_config_home := os.environ.get("XDG_CONFIG_HOME")) is not None:
        config_home_path = Path(xdg_config_home)
    else:
        config_home_path = Path.home() / ".config"

    path = config_home_path / "lm"

    if not missing_ok and not path.exists():
        sys.exit(f"Config directory not found: {path}\nRun `lm init` to initialize it.")

    return path


def _get_data_path(*, missing_ok: bool) -> Path:
    if (lm_data_dir := os.environ.get(LM_DATA_DIR_ENV)) is not None:
        path = Path(lm_data_dir)
    else:
        if (xdg_data_home := os.environ.get("XDG_DATA_HOME")) is not None:
            data_home_path = Path(xdg_data_home)
        else:
            data_home_path = Path.home() / ".local/share"
        path = data_home_path / "lm"

    if not missing_ok and not path.exists():
        sys.exit(f"Data directory not found: {path}\nRun `lm init` to initialize it.")

    return path


def _write_read_only(path: Path, content: str) -> None:
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o444)
    with os.fdopen(fd, "w") as f:
        f.write(content)


def _create_thread(path: Path, *, claude_model: str, claude_tools: str) -> _Thread:
    thread = _Thread(path)

    thread.path.mkdir()
    thread.claude_path.mkdir()
    thread.scratch_cwd_path.mkdir()

    # We tie these to the thread for simplicity and not to bust cache
    _write_read_only(thread.model_path, claude_model)
    _write_read_only(thread.tools_path, claude_tools)

    return thread


def _commit_staged(thread: _Thread, response: str) -> None:
    turn = _Exchanges.Turn(thread.get_turn_path(_get_turns_count(thread)))

    thread.staged_path.rename(turn.path)

    for path in turn.path.rglob("*"):
        if path.is_file():
            path.chmod(0o444)

    _write_read_only(turn.response_path, response)


def _remove_query(query: _Exchanges.Query) -> None:
    query.prompt_path.unlink(missing_ok=True)
    query.stdin_path.unlink(missing_ok=True)
    _remove_attachments(query)
    query.path.rmdir()


def _remove_turn(turn: _Exchanges.Turn) -> None:
    turn.prompt_path.unlink()
    turn.response_path.unlink()

    turn.stdin_path.unlink(missing_ok=True)
    _remove_attachments(turn)

    turn.path.rmdir()


def _remove_attachments(exchange: _Exchanges._Base) -> None:
    path = exchange.attachments_path
    if not path.exists():
        return

    for attachment_path in path.iterdir():
        attachment_path.unlink()
    path.rmdir()


def _assert_thread_name_is_valid(name: str) -> None:
    if name == "" or name in {".", ".."} or name.startswith(".") or "/" in name:
        sys.exit(f"Invalid thread name: {name}")


def _assert_thread_exists(path: Path) -> None:
    if not path.exists():
        sys.exit("Thread does not exist.")


def _assert_thread_doesnt_exist(path: Path) -> None:
    if path.exists():
        sys.exit("Thread already exists.")


def _assert_no_staged_query(thread: _Thread) -> None:
    if thread.staged_path.exists():
        sys.exit(
            f"Staged query already exists in thread '{thread.name}'.\n"
            f"  See it with:     lm status -t {thread.name}\n"
            f"  Send it with:    lm commit -t {thread.name}\n"
            f"  Discard it with: lm clear -t {thread.name}"
        )


def _resolve_claude_tools(capabilities: list[str]) -> str:
    return ",".join(t for c in capabilities for t in CAPABILITY_CLAUDE_TOOLS[c])


class _ClaudeContext:
    def __init__(
        self,
        session_id: str,
        session_path: Path,
        session_expected_path: Path,
        scratch_cwd_path: Path,
        attachments_path: Path | None,
    ) -> None:
        self._session_id = session_id
        self._session_path = session_path
        self._session_expected_path = session_expected_path
        self._scratch_cwd_path = scratch_cwd_path
        self._attachments_path = attachments_path

    @staticmethod
    def create(
        *, session_path: Path, scratch_cwd_path: Path, attachments_path: Path | None
    ) -> _ClaudeContext:
        # Ref: https://code.claude.com/docs/en/agent-sdk/sessions
        projects_path = Path.home() / ".claude/projects"
        escaped_cwd = re.sub(r"[^a-zA-Z0-9]", "-", str(scratch_cwd_path.resolve()))
        project_path = projects_path / escaped_cwd
        id_ = str(uuid.uuid4())
        session_expected_path = project_path / f"{id_}.jsonl"
        return _ClaudeContext(
            id_, session_path, session_expected_path, scratch_cwd_path, attachments_path
        )

    def __enter__(self) -> tuple[tuple[str, str], str | None]:
        if not self._session_path.exists():
            flag = "--session-id"
        else:
            flag = "--resume"
            self._session_expected_path.symlink_to(self._session_path.resolve())

        if self._attachments_path is None:
            attachments_prompt = None
        else:
            attachments_prompt_lines = ["Attached files:"]
            for src in self._attachments_path.iterdir():
                dst = self._scratch_cwd_path / src.name
                dst.symlink_to(
                    src.resolve().relative_to(
                        self._scratch_cwd_path.resolve(), walk_up=True
                    )
                )
                attachments_prompt_lines.append(f"- @{dst.name}")
            attachments_prompt = "\n".join(attachments_prompt_lines)

        return (flag, self._session_id), attachments_prompt

    def __exit__(
        self,
        exc_type: type[BaseException] | None,
        exc_val: BaseException | None,
        exc_tb: TracebackType | None,
    ) -> None:
        if self._session_expected_path.is_symlink():
            self._session_expected_path.unlink()
        elif self._session_expected_path.exists():
            self._session_expected_path.rename(self._session_path)

        for path in self._scratch_cwd_path.iterdir():
            path.unlink()


if __name__ == "__main__":
    main()
