def _write_paged(content: str) -> None:
    if not sys.stdout.isatty():
        sys.stdout.write(content)
        return

    pager = os.getenv("PAGER", "less")
    env = os.environ.copy()
    env.setdefault("LESS", "-FRX")
    with subprocess.Popen(  # noqa: S603  (running the user pager expected to be safe)
        pager,
        stdin=subprocess.PIPE,
        text=True,
        env=env,
    ) as pager_proc:
        if pager_proc.stdin is None:
            sys.exit("Unexpected error: Pager standard input not captured")
        pager_proc.stdin.write(content)


def _format_threads_summary(threads: list[_Thread]) -> str:
    return "".join(f"{_format_thread_summary_line(thread)}\n" for thread in threads)


def _format_thread_summary_line(thread: _Thread) -> str:
    name = _compress_text(thread.name, max_length=LS_NAME_LENGTH)
    turns_count = _get_turns_count(thread)

    header = f"{name:<{LS_NAME_LENGTH}}   {turns_count:{LS_TURNS_COUNT_WIDTH}d}t"
    if turns_count == 0:
        return header

    last_turn = _Exchanges.Turn(thread.get_turn_path(turns_count - 1))
    prompt = _summarize_text(
        last_turn.prompt_path.read_text(), max_length=LS_PROMPT_LENGTH
    )
    response = _summarize_text(
        last_turn.response_path.read_text(), max_length=LS_RESPONSE_LENGTH
    )

    return f"{header}   {prompt:<{LS_PROMPT_LENGTH}}   {response:<{LS_RESPONSE_LENGTH}}"


def _format_status(thread: _Thread) -> str:
    claude_tools = thread.tools_path.read_text()
    tools = "none" if claude_tools == "" else ", ".join(claude_tools.split(","))

    lines = [
        f"{'Thread:':<{STATUS_LABEL_WIDTH}}{thread.name}",
        f"{'Model:':<{STATUS_LABEL_WIDTH}}{thread.model_path.read_text()}",
        f"{'Tools:':<{STATUS_LABEL_WIDTH}}{tools}",
        f"{'Turns:':<{STATUS_LABEL_WIDTH}}{_get_turns_count(thread)}",
        "",
    ]

    staged = _Exchanges.Query(thread.staged_path)
    if not staged.path.exists():
        lines.append("Nothing staged.")
        return "\n".join(lines) + "\n"

    staged_lines = _format_staged(staged)
    # edit-prompt and attach both create the directory before they fill it
    if len(staged_lines) == 0:
        lines.append("Staged: empty.")
        return "\n".join(lines) + "\n"

    lines.append("Staged:")
    lines.extend(staged_lines)

    return "\n".join(lines) + "\n"


def _format_staged(staged: _Exchanges.Query) -> list[str]:
    lines: list[str] = []

    prompt_path = staged.prompt_path
    if prompt_path.exists():
        prompt = _summarize_text(
            prompt_path.read_text(), max_length=PROMPT_SUMMARY_MAX_LENGTH
        )
        lines.append(f"  {'prompt':<{STATUS_STAGED_LABEL_WIDTH}}{prompt}")

    stdin_path = staged.stdin_path
    if stdin_path.exists():
        lines_count = len(stdin_path.read_text().splitlines())
        plural = "" if lines_count == 1 else "s"
        lines.append(
            f"  {'stdin':<{STATUS_STAGED_LABEL_WIDTH}}{lines_count} line{plural}"
        )

    attachments_path = staged.attachments_path
    if attachments_path.exists():
        names = sorted(p.name for p in attachments_path.iterdir())
        lines.append(
            f"  {'attachments':<{STATUS_STAGED_LABEL_WIDTH}}{', '.join(names)}"
        )

    return lines


