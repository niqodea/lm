def _assert_initialized(env: _Environment) -> None:
    if not env.config_path.exists():
        sys.exit(
            f"Config directory not found: {env.config_path}\n"
            "Run `lm init` to initialize it."
        )
    if not env.data_path.exists():
        sys.exit(
            f"Data directory not found: {env.data_path}\n"
            "Run `lm init` to initialize it."
        )


def _get_preset(name: str, config_path: Path) -> str:
    presets_path = config_path / PRESETS_PATHNAME
    path = presets_path / f"{name}.md"
    if not path.exists():
        sys.exit(f"Preset not found: {path}")
    return path.read_text()


def _get_default_system_prompt(config_path: Path) -> str:
    path = config_path / DEFAULT_SYSTEM_PROMPT_PATHNAME
    if not path.exists():
        sys.exit(f"Default system prompt not found: {path}")
    return path.read_text()


def _get_system_prompt(name: str, config_path: Path) -> str:
    system_prompts_path = config_path / SYSTEM_PROMPTS_PATHNAME
    path = system_prompts_path / f"{name}.md"
    if not path.exists():
        sys.exit(f"System prompt not found: {path}")
    return path.read_text()


@dataclass(frozen=True)
class _Settings:
    """The user's settings for lm."""

    char_delay_seconds: float
    default_claude_model: str
    default_claude_effort: str
    claude_model_aliases: Mapping[str, str]


def _get_settings(config_path: Path) -> _Settings:
    settings_path = config_path / SETTINGS_PATHNAME
    settings = tomllib.loads(settings_path.read_text())

    output = settings.get(SETTINGS_OUTPUT_KEY, {})
    if not isinstance(output, dict):
        sys.exit(f"Setting {SETTINGS_OUTPUT_KEY} must be a table: {output}")
    char_delay_key = f"{SETTINGS_OUTPUT_KEY}.{SETTINGS_OUTPUT_CHAR_DELAY_KEY}"
    char_delay_seconds = output.get(SETTINGS_OUTPUT_CHAR_DELAY_KEY, 0.0)
    if not isinstance(char_delay_seconds, float):
        sys.exit(f"Setting {char_delay_key} must be a float: {char_delay_seconds}")

    defaults = settings.get(SETTINGS_DEFAULTS_KEY, {})
    if not isinstance(defaults, dict):
        sys.exit(f"Setting {SETTINGS_DEFAULTS_KEY} must be a table: {defaults}")
    model_key = f"{SETTINGS_DEFAULTS_KEY}.{SETTINGS_DEFAULT_MODEL_KEY}"
    default_claude_model = defaults.get(
        SETTINGS_DEFAULT_MODEL_KEY, DEFAULT_CLAUDE_MODEL
    )
    if not isinstance(default_claude_model, str):
        sys.exit(f"Setting {model_key} must be a string: {default_claude_model}")
    effort_key = f"{SETTINGS_DEFAULTS_KEY}.{SETTINGS_DEFAULT_EFFORT_KEY}"
    default_claude_effort = defaults.get(
        SETTINGS_DEFAULT_EFFORT_KEY, DEFAULT_CLAUDE_EFFORT
    )
    if not isinstance(default_claude_effort, str):
        sys.exit(f"Setting {effort_key} must be a string: {default_claude_effort}")
    if default_claude_effort not in CLAUDE_EFFORTS:
        sys.exit(f"Unknown Claude effort: {default_claude_effort}")

    models = settings.get(SETTINGS_MODELS_KEY, {})
    if not isinstance(models, dict):
        sys.exit(f"Setting {SETTINGS_MODELS_KEY} must be a table: {models}")
    claude_model_aliases: dict[str, str] = {}
    for alias, model in models.items():
        if not isinstance(model, str):
            sys.exit(f"Model alias {alias} must be a string: {model}")
        claude_model_aliases[alias] = model

    return _Settings(
        char_delay_seconds=char_delay_seconds,
        default_claude_model=default_claude_model,
        default_claude_effort=default_claude_effort,
        claude_model_aliases=claude_model_aliases,
    )


def _write_read_only(path: Path, content: str) -> None:
    file_descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o444)
    with os.fdopen(file_descriptor, "w") as file:
        file.write(content)


