TOOLS_PATHNAME = "tools"

PROMPT_PATHNAME = "prompt.md"
RESPONSE_PATHNAME = "response.md"
ATTACHMENTS_PATHNAME = "attachments"
STDIN_PATHNAME = "stdin"


SCISSORS_LINE = "<!-- ------------------------ >8 ------------------------ -->"

SYSTEM_PROMPT = """\
You are a helpful assistant. Answer the question concisely.
"""

PROMPT_SUMMARY_MAX_LENGTH = 100

LS_NAME_LENGTH = 15
LS_PROMPT_LENGTH = 30
LS_RESPONSE_LENGTH = 50

DEFAULT_CLAUDE_MODEL = "claude-sonnet-4-6"

INSERT_MODE_EDITORS = {"vim", "nvim"}
PROMPT_IS_LAST_EDITORS = {"vi", "vim", "nvim"}

SETTINGS_CHAR_DELAY_KEY = "char_delay"

