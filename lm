ATTACHMENT_MAX_SIZE_BYTES = 10 * 1024 * 1024  # 10 MB


def main() -> None:
    """Entry point for the CLI."""
    parser = argparse.ArgumentParser(prog="lm")

    subparsers = parser.add_subparsers(dest="command", required=True)

    init_parser = subparsers.add_parser(
        "init",
        help="Initialize configuration and data directories.",
    )
    init_parser.set_defaults(func=_cmd_init)

    run_parser = subparsers.add_parser(
        "run",
        help="Run inference on a prompt.",
    )
    run_parser.set_defaults(func=_cmd_run)
    _add_thread_args(run_parser, required=False)
    run_parser.add_argument(
        "-p",
        "--preset",
        help="Preset name.",
    )
    run_parser.add_argument(
        "-a",
        "--attach",
        dest="attachments",
        action="append",
        default=[],
        metavar="FILE[:ALIAS]",
        help="File to attach and make available to the model (repeatable).",
    )

    new_parser = subparsers.add_parser(
        "new",
        help="Start a new thread.",
    )
    new_parser.set_defaults(func=_cmd_new)
    new_parser.add_argument(
        "name",
        help="Thread name.",
    )
    new_parser.add_argument(
        "-m",
        "--claude-model",
        help="Claude model to use for this thread.",
        default=DEFAULT_CLAUDE_MODEL,
    )
    new_parser.add_argument(
        "-w",
        "--with",
        dest="capabilities",
        action="append",
        default=[],
        choices=list(CAPABILITY_CLAUDE_TOOLS),
        help="Capabilities to enable for this thread (repeatable).",
    )

    mv_parser = subparsers.add_parser(
        "mv",
        help="Rename a thread.",
    )
    mv_parser.set_defaults(func=_cmd_mv)
    mv_parser.add_argument(
        "src",
        help="Source thread name.",
    )
    mv_parser.add_argument(
        "dst",
        help="Destination thread name.",
    )

    edit_prompt_parser = subparsers.add_parser(
        "edit-prompt",
        help="Edit prompt for the staged query.",
    )
    edit_prompt_parser.set_defaults(func=_cmd_edit_prompt)
    _add_thread_args(edit_prompt_parser, required=True)
    edit_prompt_parser.add_argument(
        "-p",
        "--preset",
        help="Preset name.",
    )

    attach_parser = subparsers.add_parser(
        "attach",
        help="Add attachments for the staged query.",
    )
    attach_parser.set_defaults(func=_cmd_attach)
    _add_thread_args(attach_parser, required=True)
    attach_parser.add_argument(
        "attachments",
        nargs="+",
        metavar="FILE[:ALIAS]",
        help="File to attach and make available to the model (repeatable).",
    )

    commit_parser = subparsers.add_parser(
        "commit",
        help="Run inference on the staged query.",
    )
    commit_parser.set_defaults(func=_cmd_commit)
    _add_thread_args(commit_parser, required=True)

    clear_parser = subparsers.add_parser(
        "clear",
        help="Clear the staged query without running inference.",
    )
    clear_parser.set_defaults(func=_cmd_clear)
    _add_thread_args(clear_parser, required=True)

    ls_parser = subparsers.add_parser("ls", help="List threads.")
    ls_parser.set_defaults(func=_cmd_ls)

    show_parser = subparsers.add_parser("show", help="Show the turns of a thread.")
    show_parser.set_defaults(func=_cmd_show)
    _add_thread_args(show_parser, required=True)

    chat_parser = subparsers.add_parser("chat", help="Loop: edit prompt, run, repeat.")
    chat_parser.set_defaults(func=_cmd_chat)
    _add_thread_args(chat_parser, required=False)

    args = parser.parse_args()
    args.func(args)


def _cmd_init(_: argparse.Namespace) -> None:
    config_path = _get_config_path(missing_ok=True)
    data_path = _get_data_path(missing_ok=True)

    if not config_path.exists():
        config_path.mkdir()
        (config_path / SETTINGS_PATHNAME).touch()
        (config_path / PRESETS_PATHNAME).mkdir()

    if not data_path.exists():
        data_path.mkdir()
        (data_path / THREADS_PATHNAME).mkdir()


def _cmd_run(args: argparse.Namespace) -> None:
    config_path = _get_config_path(missing_ok=False)
    data_path = _get_data_path(missing_ok=False)
    threads_path = data_path / THREADS_PATHNAME

    preset_name: str | None = args.preset
    draft = None if preset_name is None else _get_preset(preset_name, config_path)
    attachments = [_get_attachment(a) for a in args.attachments]

    if _has_thread_arg(args):
        thread_path = _get_thread_path(args, threads_path)
        if (thread_path / STAGED_PATHNAME).exists():
            sys.exit(
                "Staged query already exists, cannot run. "
                "Please commit or clear the staged query first."
            )
        editmsg_path = thread_path / EDITMSG_PATHNAME
        history = _build_history(thread_path)
        prompt = _edit_prompt(editmsg_path, history=history, draft=draft)
        if prompt is None:
            sys.exit("Prompt is empty, exiting.")
    else:
        thread_timestamp = (
            datetime.datetime.now().astimezone().strftime("%Y%m%d-%H%M%S")
        )
        editmsg_pathname = TIMESTAMP_EDITMSG_PATHNAME_TEMPLATE.format(
            timestamp=thread_timestamp
        )
        editmsg_path = threads_path / editmsg_pathname
        prompt = _edit_prompt(editmsg_path, history=[], draft=draft)
        if prompt is None:
            sys.exit("Prompt is empty, exiting.")

        sys.stderr.write(f"Creating new thread: {thread_timestamp}\n")
        thread_path = threads_path / thread_timestamp
        _create_thread(thread_path, claude_model=DEFAULT_CLAUDE_MODEL, claude_tools="")

    staged_path = thread_path / STAGED_PATHNAME
    staged_path.mkdir()
    # new line at the end to be in line with response and stick to best practices
    (staged_path / PROMPT_PATHNAME).write_text(f"{prompt}\n")

    if sys.stdin.isatty():
        piped_stdin = ""
    else:
        piped_stdin = sys.stdin.read()
        (staged_path / STDIN_PATHNAME).write_text(piped_stdin)

    if not attachments:
        attachments_path = None
    else:
        attachments_path = staged_path / ATTACHMENTS_PATHNAME
        attachments_path.mkdir()
        _write_attachments(attachments, attachments_path)

    response = _execute_turn(
        prompt=prompt,
        piped_stdin=piped_stdin,
        attachments_path=attachments_path,
        claude_model=(thread_path / CLAUDE_PATHNAME / MODEL_PATHNAME).read_text(),
        claude_tools=(thread_path / CLAUDE_PATHNAME / TOOLS_PATHNAME).read_text(),
        claude_scratch_cwd_path=thread_path / CLAUDE_PATHNAME / SCRATCH_CWD_PATHNAME,
        claude_session_path=(thread_path / CLAUDE_PATHNAME / SESSION_PATHNAME),
        char_delay=_get_char_delay_from_settings(config_path),
    )

    _commit_staged(thread_path, response)


def _cmd_new(args: argparse.Namespace) -> None:
    data_path = _get_data_path(missing_ok=False)
    threads_path = data_path / THREADS_PATHNAME

    name: str = args.name
    capabilities: list[str] = args.capabilities
    claude_model: str = args.claude_model

    _assert_thread_name_is_valid(name)

    path = threads_path / name
    _assert_thread_doesnt_exist(path)

    _create_thread(
        path,
        claude_model=claude_model,
        claude_tools=_resolve_claude_tools(capabilities),
    )


def _cmd_mv(args: argparse.Namespace) -> None:
    data_path = _get_data_path(missing_ok=False)
    threads_path = data_path / THREADS_PATHNAME

    _assert_thread_name_is_valid(args.src)
    _assert_thread_name_is_valid(args.dst)

    src_path = threads_path / args.src
    dst_path = threads_path / args.dst

    _assert_thread_exists(src_path)
    _assert_thread_doesnt_exist(dst_path)

    src_path.rename(dst_path)


def _cmd_edit_prompt(args: argparse.Namespace) -> None:
    config_path = _get_config_path(missing_ok=False)
    data_path = _get_data_path(missing_ok=False)
    threads_path = data_path / THREADS_PATHNAME

    thread_path = _get_thread_path(args, threads_path)
    preset_name: str | None = args.preset

    staged_path = thread_path / STAGED_PATHNAME
    staged_path.mkdir(exist_ok=True)

    staged_prompt_path = staged_path / PROMPT_PATHNAME

    match staged_prompt_path.exists(), preset_name:
        case False, None:
            draft: str | None = None
        case False, str():
            draft = _get_preset(preset_name, config_path)
        case True, None:
            draft = staged_prompt_path.read_text()
        case True, str():
            sys.exit("Staged prompt already exists, cannot apply preset.")

    history = _build_history(thread_path)
    prompt = _edit_prompt(thread_path / EDITMSG_PATHNAME, history=history, draft=draft)
    if prompt is None:
        sys.exit("Prompt is empty, exiting.")

    # new line at the end to be in line with response and stick to best practices
    staged_prompt_path.write_text(f"{prompt}\n")


def _cmd_attach(args: argparse.Namespace) -> None:
    data_path = _get_data_path(missing_ok=False)
    threads_path = data_path / THREADS_PATHNAME

    thread_path = _get_thread_path(args, threads_path)
    attachments = [_get_attachment(a) for a in args.attachments]

    staged_path = thread_path / STAGED_PATHNAME
    staged_path.mkdir(exist_ok=True)

    attachments_path = staged_path / ATTACHMENTS_PATHNAME
    attachments_path.mkdir(exist_ok=True)
    _write_attachments(attachments, attachments_path)


def _cmd_commit(args: argparse.Namespace) -> None:
    config_path = _get_config_path(missing_ok=False)
    data_path = _get_data_path(missing_ok=False)
    threads_path = data_path / THREADS_PATHNAME

    thread_path = _get_thread_path(args, threads_path)

    staged_path = thread_path / STAGED_PATHNAME
    if not staged_path.exists():
        sys.exit("No staged query found.")

    staged_prompt_path = staged_path / PROMPT_PATHNAME
    if not staged_prompt_path.exists():
        sys.exit("No staged prompt found.")

    prompt = staged_prompt_path.read_text().strip()
    if not prompt:
        sys.exit("Prompt is empty, exiting.")

    staged_stdin_path = staged_path / STDIN_PATHNAME
    piped_stdin = staged_stdin_path.read_text() if staged_stdin_path.exists() else ""

    attachments_path = staged_path / ATTACHMENTS_PATHNAME

    response = _execute_turn(
        prompt=prompt,
        piped_stdin=piped_stdin,
        attachments_path=attachments_path if attachments_path.exists() else None,
        claude_model=(thread_path / CLAUDE_PATHNAME / MODEL_PATHNAME).read_text(),
        claude_tools=(thread_path / CLAUDE_PATHNAME / TOOLS_PATHNAME).read_text(),
        claude_scratch_cwd_path=thread_path / CLAUDE_PATHNAME / SCRATCH_CWD_PATHNAME,
        claude_session_path=thread_path / CLAUDE_PATHNAME / SESSION_PATHNAME,
        char_delay=_get_char_delay_from_settings(config_path),
    )

    _commit_staged(thread_path, response)


def _cmd_clear(args: argparse.Namespace) -> None:
    data_path = _get_data_path(missing_ok=False)
    threads_path = data_path / THREADS_PATHNAME

    thread_path = _get_thread_path(args, threads_path)

    staged_path = thread_path / STAGED_PATHNAME

    if not staged_path.exists():
        sys.exit("No staged query found.")

    staged_prompt_path = staged_path / PROMPT_PATHNAME
    staged_prompt_path.unlink(missing_ok=True)

    staged_stdin_path = staged_path / STDIN_PATHNAME
    staged_stdin_path.unlink(missing_ok=True)

    staged_attachments_path = staged_path / ATTACHMENTS_PATHNAME
    if staged_attachments_path.exists():
        for path in staged_attachments_path.iterdir():
            path.unlink(missing_ok=True)
        staged_attachments_path.rmdir()

    staged_path.rmdir()


def _cmd_ls(_: argparse.Namespace) -> None:
    data_path = _get_data_path(missing_ok=False)
    threads_path = data_path / THREADS_PATHNAME

    paths = sorted(
        (p for p in threads_path.iterdir() if p.is_dir()),
        # NOTE: Not a super robust way to sort by last activity, but simple and works
        key=lambda p: p.stat().st_mtime,
        reverse=True,
    )
    names = [p.name for p in paths]

    _write_paged(_format_threads_summary(names, threads_path))


def _cmd_show(args: argparse.Namespace) -> None:
    data_path = _get_data_path(missing_ok=False)
    threads_path = data_path / THREADS_PATHNAME

    thread_path = _get_thread_path(args, threads_path)

    history = _build_history(thread_path)
    history_components = _format_history(history)

    _write_paged("\n\n".join(history_components))


def _cmd_chat(args: argparse.Namespace) -> None:
    config_path = _get_config_path(missing_ok=False)
    data_path = _get_data_path(missing_ok=False)
    threads_path = data_path / THREADS_PATHNAME

    if _has_thread_arg(args):
        thread_path = _get_thread_path(args, threads_path)
        if (thread_path / STAGED_PATHNAME).exists():
            sys.exit(
                "Staged query already exists, cannot run. "
                "Please commit or clear the staged query first."
            )
        editmsg_path = thread_path / EDITMSG_PATHNAME
        history = _build_history(thread_path)
        prompt = _edit_prompt(editmsg_path, history=history, draft=None)
        if prompt is None:
            return
    else:
        thread_timestamp = (
            datetime.datetime.now().astimezone().strftime("%Y%m%d-%H%M%S")
        )
        editmsg_pathname = TIMESTAMP_EDITMSG_PATHNAME_TEMPLATE.format(
            timestamp=thread_timestamp
        )
        editmsg_path = threads_path / editmsg_pathname
        history = []
        prompt = _edit_prompt(editmsg_path, history=history, draft=None)
        if prompt is None:
            return
        sys.stderr.write(f"Creating new thread: {thread_timestamp}\n")
        thread_path = threads_path / thread_timestamp
        _create_thread(thread_path, claude_model=DEFAULT_CLAUDE_MODEL, claude_tools="")

    while True:
        staged_path = thread_path / STAGED_PATHNAME
        staged_path.mkdir(exist_ok=True)
        # new line at the end to be in line with response and stick to best practices
        (staged_path / PROMPT_PATHNAME).write_text(f"{prompt}\n")

        response = _execute_turn(
            prompt=prompt,
            piped_stdin="",
            attachments_path=None,
            claude_model=(thread_path / CLAUDE_PATHNAME / MODEL_PATHNAME).read_text(),
            claude_tools=(thread_path / CLAUDE_PATHNAME / TOOLS_PATHNAME).read_text(),
            claude_scratch_cwd_path=thread_path
            / CLAUDE_PATHNAME
            / SCRATCH_CWD_PATHNAME,
            claude_session_path=(thread_path / CLAUDE_PATHNAME / SESSION_PATHNAME),
            char_delay=_get_char_delay_from_settings(config_path),
        )

        _commit_staged(thread_path, response)

        # Update mutable variables for next iteration
        history.append((prompt, [], response))
        prompt = _edit_prompt(editmsg_path, history=history, draft=None)
        if prompt is None:
            return


