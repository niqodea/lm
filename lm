LM_DATA_DIR_ENV = "LM_DATA_DIR"

SETTINGS_PATHNAME = "settings.toml"
PRESETS_PATHNAME = "presets"

THREADS_PATHNAME = "threads"

TURN_IDX_ZEROPAD = 2
EDITMSG_PATHNAME = ".EDITMSG.md"
TIMESTAMP_EDITMSG_PATHNAME_TEMPLATE = ".{timestamp}-EDITMSG.md"
STAGED_PATHNAME = "STAGED"

CLAUDE_PATHNAME = ".claude"
SCRATCH_CWD_PATHNAME = "scratch-cwd"
MODEL_PATHNAME = "model"
