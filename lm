# --- commands


def main() -> None:
    """Entry point for the CLI."""
    parser = argparse.ArgumentParser(prog="lm")

    subparsers = parser.add_subparsers(dest="command", required=True)

    init_parser = subparsers.add_parser(
        "init",
        help="Initialize configuration and data directories.",
    )
    init_parser.set_defaults(func=_execute_init)

    run_parser = subparsers.add_parser(
        "run",
        help="Start a new thread and run inference on its first prompt.",
    )
    run_parser.set_defaults(func=_execute_run)
    run_parser.add_argument(
        "name",
        nargs="?",
        help="Thread name (default: a timestamp).",
    )
    _add_thread_settings_args(run_parser)
    _add_query_args(run_parser)

    reply_parser = subparsers.add_parser(
        "reply",
        help="Run inference on the next prompt of a thread.",
    )
    reply_parser.set_defaults(func=_execute_reply)
    _add_thread_args(reply_parser)
    _add_query_args(reply_parser)

    new_parser = subparsers.add_parser(
        "new",
        help="Start a new thread.",
    )
    new_parser.set_defaults(func=_execute_new)
    new_parser.add_argument(
        "name",
        help="Thread name.",
    )
    _add_thread_settings_args(new_parser)

    rename_parser = subparsers.add_parser(
        "rename",
        help="Rename a thread.",
    )
    rename_parser.set_defaults(func=_execute_rename)
    _add_thread_args(rename_parser)
    rename_parser.add_argument(
        "destination",
        help="Destination thread name.",
    )

    rm_parser = subparsers.add_parser(
        "rm",
        help="Delete a thread.",
    )
    rm_parser.set_defaults(func=_execute_rm)
    _add_thread_args(rm_parser)

    undo_parser = subparsers.add_parser(
        "undo",
        help="Turn the last turn of a thread back into the staged query.",
    )
    undo_parser.set_defaults(func=_execute_undo)
    _add_thread_args(undo_parser)

    edit_prompt_parser = subparsers.add_parser(
        "edit-prompt",
        help="Edit prompt for the staged query.",
    )
    edit_prompt_parser.set_defaults(func=_execute_edit_prompt)
    _add_thread_args(edit_prompt_parser)
    edit_prompt_parser.add_argument(
        "-p",
        "--preset",
        help="Preset name.",
    )

    attach_parser = subparsers.add_parser(
        "attach",
        help="Add attachments for the staged query.",
    )
    attach_parser.set_defaults(func=_execute_attach)
    _add_thread_args(attach_parser)
    attach_parser.add_argument(
        "attachments",
        nargs="+",
        metavar="FILE[:ALIAS]",
        help="File to attach and make available to the model (repeatable).",
    )

    commit_parser = subparsers.add_parser(
        "commit",
        help="Run inference on the staged query.",
    )
    commit_parser.set_defaults(func=_execute_commit)
    _add_thread_args(commit_parser)

    clear_parser = subparsers.add_parser(
        "clear",
        help="Clear the staged query without running inference.",
    )
    clear_parser.set_defaults(func=_execute_clear)
    _add_thread_args(clear_parser)

    ls_parser = subparsers.add_parser("ls", help="List threads.")
    ls_parser.set_defaults(func=_execute_ls)

    show_parser = subparsers.add_parser("show", help="Show the turns of a thread.")
    show_parser.set_defaults(func=_execute_show)
    _add_thread_args(show_parser)

    status_parser = subparsers.add_parser(
        "status", help="Show the settings of a thread and its staged query."
    )
    status_parser.set_defaults(func=_execute_status)
    _add_thread_args(status_parser)

    args = parser.parse_args()

    env = _Environment.create()

    try:
        args.func(args, env)
    except KeyboardInterrupt:
        sys.exit(INTERRUPT_EXIT_CODE)


def _add_thread_settings_args(parser: argparse.ArgumentParser) -> None:
    parser.add_argument(
        "-m",
        "--claude-model",
        help="Claude model to use for this thread, or an alias from settings.",
    )
    parser.add_argument(
        "-e",
        "--claude-effort",
        help="Claude effort level to use for this thread.",
        choices=CLAUDE_EFFORTS,
    )
    parser.add_argument(
        "-S",
        "--system-prompt",
        help="Name of the system prompt to use for this thread.",
    )
    parser.add_argument(
        "-w",
        "--with",
        dest="capabilities",
        action="append",
        default=[],
        choices=list(CAPABILITY_CLAUDE_TOOLS),
        help="Capabilities to enable for this thread (repeatable).",
    )


def _add_query_args(parser: argparse.ArgumentParser) -> None:
    parser.add_argument(
        "-p",
        "--preset",
        help="Preset name.",
    )
    parser.add_argument(
        "-a",
        "--attach",
        dest="attachments",
        action="append",
        default=[],
        metavar="FILE[:ALIAS]",
        help="File to attach and make available to the model (repeatable).",
    )
    parser.add_argument(
        "-c",
        "--chat",
        action="store_true",
        help="Keep prompting for the next turn until a prompt is left empty.",
    )


@dataclass(frozen=True)
class _Environment:
    """What lm reads from outside the process."""

    config_path: Path
    data_path: Path
    claude_projects_path: Path
    editor: str
    tty_path: Path
    pager: str
    started_at: datetime.datetime

    @staticmethod
    def create() -> _Environment:
        if (xdg_config_home := os.environ.get("XDG_CONFIG_HOME")) is not None:
            config_home_path = Path(xdg_config_home)
        else:
            config_home_path = Path.home() / ".config"

        if (lm_data_dir := os.environ.get(LM_DATA_DIR_ENV)) is not None:
            data_path = Path(lm_data_dir)
        else:
            if (xdg_data_home := os.environ.get("XDG_DATA_HOME")) is not None:
                data_home_path = Path(xdg_data_home)
            else:
                data_home_path = Path.home() / ".local/share"
            data_path = data_home_path / "lm"

        return _Environment(
            config_path=config_home_path / "lm",
            data_path=data_path,
            claude_projects_path=Path.home() / ".claude" / "projects",
            editor=os.getenv("EDITOR", "vim"),
            # The tests have no terminal to hand the editor, so they point this at
            # a file
            tty_path=Path(os.getenv(LM_TTY_ENV, "/dev/tty")),
            pager=os.getenv("PAGER", "less"),
            started_at=datetime.datetime.now().astimezone(),
        )


def _execute_init(_: argparse.Namespace, env: _Environment) -> None:
    config_path = env.config_path
    data_path = env.data_path

    if not config_path.exists():
        config_path.mkdir()
        (config_path / SETTINGS_PATHNAME).touch()
        (config_path / PRESETS_PATHNAME).mkdir()
        (config_path / SYSTEM_PROMPTS_PATHNAME).mkdir()
        default_system_prompt_path = config_path / DEFAULT_SYSTEM_PROMPT_PATHNAME
        default_system_prompt_path.write_text(DEFAULT_SYSTEM_PROMPT)

    if not data_path.exists():
        data_path.mkdir()
        (data_path / THREADS_PATHNAME).mkdir()


def _execute_run(args: argparse.Namespace, env: _Environment) -> None:
    _assert_initialized(env)
    config_path = env.config_path
    threads_path = env.data_path / THREADS_PATHNAME

    preset_name: str | None = args.preset
    draft = None if preset_name is None else _get_preset(preset_name, config_path)
    attachments = _get_attachments(args.attachments)
    is_chat: bool = args.chat
    settings = _get_settings(config_path)
    thread_settings = _get_thread_settings(args, settings, config_path)

    arg_name: str | None = args.name
    name = env.started_at.strftime("%Y%m%d-%H%M%S") if arg_name is None else arg_name
    _assert_thread_name_is_valid(name)
    path = threads_path / name
    _assert_thread_doesnt_exist(path)

    # The thread is written only once there is a prompt for it, so abandoning
    # the editor leaves no empty thread behind
    editmsg_pathname = NEW_THREAD_EDITMSG_PATHNAME_TEMPLATE.format(name=name)
    try:
        prompt = _edit_prompt(
            threads_path / editmsg_pathname,
            history=[],
            draft=draft,
            editor=env.editor,
            tty_path=env.tty_path,
        )
    except _EmptyPromptError:
        sys.exit("Prompt is empty, exiting.")

    sys.stderr.write(f"Creating new thread: {name}\n")
    thread = _create_thread(path, thread_settings)

    piped_stdin = None if sys.stdin.isatty() else sys.stdin.read()
    _send_turn(
        thread,
        prompt,
        piped_stdin=piped_stdin,
        attachments=attachments,
        char_delay_seconds=settings.char_delay_seconds,
        claude_projects_path=env.claude_projects_path,
    )

    if is_chat:
        _chat(thread, env, char_delay_seconds=settings.char_delay_seconds)


def _execute_reply(args: argparse.Namespace, env: _Environment) -> None:
    _assert_initialized(env)
    config_path = env.config_path
    threads_path = env.data_path / THREADS_PATHNAME

    preset_name: str | None = args.preset
    draft = None if preset_name is None else _get_preset(preset_name, config_path)
    attachments = _get_attachments(args.attachments)
    is_chat: bool = args.chat
    settings = _get_settings(config_path)

    thread = _get_thread(args.thread_choice, threads_path)
    _assert_no_staged_query(thread)

    try:
        prompt = _edit_prompt(
            thread.editmsg_path,
            history=_build_history(thread),
            draft=draft,
            editor=env.editor,
            tty_path=env.tty_path,
        )
    except _EmptyPromptError:
        sys.exit("Prompt is empty, exiting.")

    piped_stdin = None if sys.stdin.isatty() else sys.stdin.read()
    _send_turn(
        thread,
        prompt,
        piped_stdin=piped_stdin,
        attachments=attachments,
        char_delay_seconds=settings.char_delay_seconds,
        claude_projects_path=env.claude_projects_path,
    )

    if is_chat:
        _chat(thread, env, char_delay_seconds=settings.char_delay_seconds)


def _execute_new(args: argparse.Namespace, env: _Environment) -> None:
    _assert_initialized(env)
    threads_path = env.data_path / THREADS_PATHNAME

    name: str = args.name
    settings = _get_settings(env.config_path)
    thread_settings = _get_thread_settings(args, settings, env.config_path)

    _assert_thread_name_is_valid(name)

    path = threads_path / name
    _assert_thread_doesnt_exist(path)

    _create_thread(path, thread_settings)


def _execute_rename(args: argparse.Namespace, env: _Environment) -> None:
    _assert_initialized(env)
    threads_path = env.data_path / THREADS_PATHNAME

    thread = _get_thread(args.thread_choice, threads_path)
    destination: str = args.destination

    _assert_thread_name_is_valid(destination)

    destination_path = threads_path / destination

    _assert_thread_doesnt_exist(destination_path)

    thread.path.rename(destination_path)


def _execute_rm(args: argparse.Namespace, env: _Environment) -> None:
    _assert_initialized(env)
    threads_path = env.data_path / THREADS_PATHNAME

    thread = _get_thread(args.thread_choice, threads_path)

    # Each file is removed by name, so a file lm did not write makes rmdir fail
    # instead of being deleted with the thread
    turns_count = _get_turns_count(thread)
    for turn_index in range(turns_count):
        _remove_turn(_Turn(thread.get_turn_path(turn_index)))

    if thread.staged_path.exists():
        _remove_query(_Query(thread.staged_path))

    thread.editmsg_path.unlink(missing_ok=True)

    thread.model_path.unlink()
    thread.effort_path.unlink()
    thread.system_prompt_path.unlink()
    thread.tools_path.unlink()
    thread.session_path.unlink(missing_ok=True)
    thread.session_lines_path.unlink()
    thread.scratch_cwd_path.rmdir()
    thread.claude_path.rmdir()

    thread.path.rmdir()


def _execute_undo(args: argparse.Namespace, env: _Environment) -> None:
    _assert_initialized(env)
    threads_path = env.data_path / THREADS_PATHNAME

    thread = _get_thread(args.thread_choice, threads_path)

    turns_count = _get_turns_count(thread)
    if turns_count == 0:
        sys.exit("No turns to undo.")
    _assert_no_staged_query(thread)

    turn_lines_counts = _get_turn_lines_counts(thread.session_lines_path)
    kept_turn_lines_counts = turn_lines_counts[:-1]
    _truncate_session(thread.session_path, kept_turn_lines_counts)
    _write_turn_lines_counts(thread.session_lines_path, kept_turn_lines_counts)

    turn = _Turn(thread.get_turn_path(turns_count - 1))
    turn.response_path.unlink()
    turn.path.rename(thread.staged_path)

    # Committing made the files read-only, and a staged query can be edited
    for path in thread.staged_path.rglob("*"):
        if path.is_file():
            path.chmod(0o644)


def _execute_edit_prompt(args: argparse.Namespace, env: _Environment) -> None:
    _assert_initialized(env)
    config_path = env.config_path
    threads_path = env.data_path / THREADS_PATHNAME

    thread = _get_thread(args.thread_choice, threads_path)
    preset_name: str | None = args.preset

    staged = _Query(thread.staged_path)
    staged_prompt_path = staged.prompt_path

    match staged_prompt_path.exists(), preset_name:
        case False, None:
            draft: str | None = None
        case False, str():
            draft = _get_preset(preset_name, config_path)
        case True, None:
            draft = staged_prompt_path.read_text()
        case True, str():
            sys.exit("Staged prompt already exists, cannot apply preset.")

    history = _build_history(thread)
    try:
        prompt = _edit_prompt(
            thread.editmsg_path,
            history=history,
            draft=draft,
            editor=env.editor,
            tty_path=env.tty_path,
        )
    except _EmptyPromptError:
        sys.exit("Prompt is empty, exiting.")

    # Created only once there is a prompt, so abandoning the editor leaves
    # nothing staged to block the next reply
    staged.path.mkdir(exist_ok=True)
    _write_prompt(staged_prompt_path, prompt)


def _execute_attach(args: argparse.Namespace, env: _Environment) -> None:
    _assert_initialized(env)
    threads_path = env.data_path / THREADS_PATHNAME

    thread = _get_thread(args.thread_choice, threads_path)
    attachments = _get_attachments(args.attachments)

    staged = _Query(thread.staged_path)
    attachments_path = staged.attachments_path
    for attachment in attachments:
        if (attachments_path / attachment.alias).exists():
            sys.exit(f"Attachment already exists with alias '{attachment.alias}'")

    staged.path.mkdir(exist_ok=True)
    attachments_path.mkdir(exist_ok=True)
    _write_attachments(attachments, attachments_path)


def _execute_commit(args: argparse.Namespace, env: _Environment) -> None:
    _assert_initialized(env)
    config_path = env.config_path
    threads_path = env.data_path / THREADS_PATHNAME

    settings = _get_settings(config_path)
    thread = _get_thread(args.thread_choice, threads_path)

    staged = _Query(thread.staged_path)
    if not staged.path.exists():
        sys.exit("No staged query found.")

    if not staged.prompt_path.exists():
        sys.exit("No staged prompt found.")

    prompt = staged.prompt_path.read_text().strip()
    if prompt == "":
        sys.exit("Prompt is empty, exiting.")

    stdin_path = staged.stdin_path
    piped_stdin = stdin_path.read_text() if stdin_path.exists() else ""

    attachments_path = staged.attachments_path

    response = _handle_turn(
        thread,
        prompt=prompt,
        piped_stdin=piped_stdin,
        attachments_path=attachments_path if attachments_path.exists() else None,
        char_delay_seconds=settings.char_delay_seconds,
        claude_projects_path=env.claude_projects_path,
    )

    _commit_staged(thread, response)


def _execute_clear(args: argparse.Namespace, env: _Environment) -> None:
    _assert_initialized(env)
    threads_path = env.data_path / THREADS_PATHNAME

    thread = _get_thread(args.thread_choice, threads_path)

    staged = _Query(thread.staged_path)

    if not staged.path.exists():
        sys.exit("No staged query found.")

    _remove_query(staged)


def _execute_ls(_: argparse.Namespace, env: _Environment) -> None:
    _assert_initialized(env)
    threads_path = env.data_path / THREADS_PATHNAME

    threads = _get_threads(threads_path)
    summary = "".join(f"{_format_thread_summary_line(thread)}\n" for thread in threads)
    _write_paged(summary, pager=env.pager)


def _execute_show(args: argparse.Namespace, env: _Environment) -> None:
    _assert_initialized(env)
    threads_path = env.data_path / THREADS_PATHNAME

    thread = _get_thread(args.thread_choice, threads_path)

    history = _build_history(thread)
    history_components = _format_history(history)

    _write_paged("\n\n".join(history_components), pager=env.pager)


def _execute_status(args: argparse.Namespace, env: _Environment) -> None:
    _assert_initialized(env)
    threads_path = env.data_path / THREADS_PATHNAME

    thread = _get_thread(args.thread_choice, threads_path)

    status = _format_status(thread)
    _write_paged(status, pager=env.pager)


# --- turns


def _send_turn(
    thread: _Thread,
    prompt: str,
    *,
    piped_stdin: str | None,
    attachments: list[_Attachment],
    char_delay_seconds: float,
    claude_projects_path: Path,
) -> None:
    """Run the prompt as the next turn of the thread, and save it."""
    staged = _Query(thread.staged_path)
    staged.path.mkdir()
    _write_prompt(staged.prompt_path, prompt)

    if piped_stdin is not None:
        staged.stdin_path.write_text(piped_stdin)

    if len(attachments) == 0:
        attachments_path = None
    else:
        attachments_path = staged.attachments_path
        attachments_path.mkdir()
        _write_attachments(attachments, attachments_path)

    response = _handle_turn(
        thread,
        prompt=prompt,
        piped_stdin="" if piped_stdin is None else piped_stdin,
        attachments_path=attachments_path,
        char_delay_seconds=char_delay_seconds,
        claude_projects_path=claude_projects_path,
    )
    _commit_staged(thread, response)


def _chat(thread: _Thread, env: _Environment, *, char_delay_seconds: float) -> None:
    """Keep prompting for the next turn of the thread until a prompt is empty."""
    while True:
        try:
            prompt = _edit_prompt(
                thread.editmsg_path,
                history=_build_history(thread),
                draft=None,
                editor=env.editor,
                tty_path=env.tty_path,
            )
        except _EmptyPromptError:
            return

        _send_turn(
            thread,
            prompt,
            piped_stdin=None,
            attachments=[],
            char_delay_seconds=char_delay_seconds,
            claude_projects_path=env.claude_projects_path,
        )


# --- threads


@dataclass(frozen=True)
class _Thread:
    """A thread directory, and where everything sits inside it."""

    path: Path

    @property
    def name(self) -> str:
        return self.path.name

    @property
    def editmsg_path(self) -> Path:
        return self.path / ".EDITMSG.md"

    @property
    def staged_path(self) -> Path:
        return self.path / "STAGED"

    @property
    def claude_path(self) -> Path:
        return self.path / ".claude"

    @property
    def model_path(self) -> Path:
        return self.claude_path / "model"

    @property
    def effort_path(self) -> Path:
        return self.claude_path / "effort"

    @property
    def system_prompt_path(self) -> Path:
        return self.claude_path / "system-prompt"

    @property
    def tools_path(self) -> Path:
        return self.claude_path / "tools"

    @property
    def session_path(self) -> Path:
        return self.claude_path / "session.jsonl"

    @property
    def session_lines_path(self) -> Path:
        return self.claude_path / "session-lines"

    @property
    def scratch_cwd_path(self) -> Path:
        return self.claude_path / "scratch-cwd"

    def get_turn_path(self, index: int) -> Path:
        return self.path / f"{index:02d}"


@dataclass(frozen=True)
class _NamedThread:
    """The thread with this name."""

    name: str


@dataclass(frozen=True)
class _LastThread:
    """The thread with the most recent activity."""


@dataclass(frozen=True)
class _SelectedThread:
    """The thread the user picks interactively."""


type _ThreadChoice = _NamedThread | _LastThread | _SelectedThread


def _add_thread_args(parser: argparse.ArgumentParser) -> None:
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument(
        "-t",
        "--thread",
        dest="thread_choice",
        type=_NamedThread,
        metavar="THREAD",
        help="Thread name.",
    )
    group.add_argument(
        "-l",
        "--last",
        dest="thread_choice",
        action="store_const",
        const=_LastThread(),
        help="Use the last active thread.",
    )
    group.add_argument(
        "-s",
        "--select",
        dest="thread_choice",
        action="store_const",
        const=_SelectedThread(),
        help="Pick a thread interactively.",
    )


def _get_thread(choice: _ThreadChoice, threads_path: Path) -> _Thread:
    match choice:
        case _NamedThread(name=name):
            thread_name = name
        case _LastThread():
            threads = _get_threads(threads_path)
            if len(threads) == 0:
                sys.exit("No threads found.")
            thread_name = threads[0].name
        case _SelectedThread():
            thread_name = _select_thread(threads_path)
        case _:
            assert_never(choice)

    _assert_thread_name_is_valid(thread_name)

    path = threads_path / thread_name
    if not path.exists():
        sys.exit("Thread does not exist.")

    return _Thread(path)


def _select_thread(threads_path: Path) -> str:
    threads = _get_threads(threads_path)
    if len(threads) == 0:
        sys.exit("No threads found.")

    # The summary shortens the name, so two threads can share one. The full name
    # rides along in a first field fzf does not show.
    lines = [
        f"{thread.name}\t{_format_thread_summary_line(thread)}" for thread in threads
    ]

    result = subprocess.run(
        # we expect path variable to be safe
        ["fzf", "--no-sort", "--delimiter", "\t", "--with-nth", "2.."],  # noqa: S607
        input="\n".join(lines),
        stdout=subprocess.PIPE,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        sys.exit("No thread selected.")

    return result.stdout.split("\t", 1)[0]


def _get_threads(threads_path: Path) -> list[_Thread]:
    paths = sorted(
        (path for path in threads_path.iterdir() if path.is_dir()),
        # TODO: Record the time of the last activity in the thread, since the
        # directory mtime misses changes made inside STAGED
        key=lambda path: path.stat().st_mtime,
        reverse=True,
    )
    return [_Thread(path) for path in paths]


@dataclass(frozen=True)
class _ThreadSettings:
    """What a thread is created with, and keeps for every turn."""

    claude_model: str
    claude_effort: str
    claude_system_prompt: str
    claude_tools: tuple[str, ...]


def _get_thread_settings(
    args: argparse.Namespace, settings: _Settings, config_path: Path
) -> _ThreadSettings:
    capabilities: list[str] = args.capabilities
    claude_model_arg: str | None = args.claude_model
    claude_effort_arg: str | None = args.claude_effort
    system_prompt_name: str | None = args.system_prompt
    claude_model = (
        settings.default_claude_model if claude_model_arg is None else claude_model_arg
    )
    claude_effort = (
        settings.default_claude_effort
        if claude_effort_arg is None
        else claude_effort_arg
    )
    claude_system_prompt = (
        _get_default_system_prompt(config_path)
        if system_prompt_name is None
        else _get_system_prompt(system_prompt_name, config_path)
    )
    return _ThreadSettings(
        claude_model=settings.claude_model_aliases.get(claude_model, claude_model),
        claude_effort=claude_effort,
        claude_system_prompt=claude_system_prompt,
        claude_tools=tuple(
            tool
            for capability in capabilities
            for tool in CAPABILITY_CLAUDE_TOOLS[capability]
        ),
    )


def _create_thread(path: Path, settings: _ThreadSettings) -> _Thread:
    thread = _Thread(path)

    thread.path.mkdir()
    thread.claude_path.mkdir()
    thread.scratch_cwd_path.mkdir()

    # We tie these to the thread for simplicity and not to bust cache
    _write_read_only(thread.model_path, settings.claude_model)
    _write_read_only(thread.effort_path, settings.claude_effort)
    _write_read_only(thread.system_prompt_path, settings.claude_system_prompt)
    _write_read_only(thread.tools_path, ",".join(settings.claude_tools))

    thread.session_lines_path.touch()

    return thread


def _get_turns_count(thread: _Thread) -> int:
    index = 0
    while thread.get_turn_path(index).exists():
        index += 1
    return index


def _get_turn_lines_counts(session_lines_path: Path) -> tuple[int, ...]:
    session_lines = session_lines_path.read_text()
    return tuple(int(line) for line in session_lines.splitlines())


def _write_turn_lines_counts(
    session_lines_path: Path, turn_lines_counts: tuple[int, ...]
) -> None:
    session_lines_path.write_text("".join(f"{count}\n" for count in turn_lines_counts))


def _truncate_session(session_path: Path, turn_lines_counts: tuple[int, ...]) -> None:
    """Keep only the lines of the session that these turns wrote."""
    # A thread without turns has no session, and claude can fail before it
    # writes the session file at all
    if len(turn_lines_counts) == 0:
        session_path.unlink(missing_ok=True)
        return

    # 2.1.283 only appends to the session file, which we observed but the docs
    # do not say, so the first lines are the ones the earlier turns wrote.
    # Ref: https://code.claude.com/docs/en/sessions#where-transcripts-are-stored
    lines = session_path.read_text().split("\n")
    kept_lines = lines[: sum(turn_lines_counts)]
    session_path.write_text("\n".join(kept_lines) + "\n")


def _assert_thread_name_is_valid(name: str) -> None:
    if name == "" or name in {".", ".."} or name.startswith(".") or "/" in name:
        sys.exit(f"Invalid thread name: {name}")


def _assert_thread_doesnt_exist(path: Path) -> None:
    if path.exists():
        sys.exit("Thread already exists.")


def _assert_no_staged_query(thread: _Thread) -> None:
    if thread.staged_path.exists():
        sys.exit(
            f"Staged query already exists in thread '{thread.name}'.\n"
            f"  See it with:     lm status -t {thread.name}\n"
            f"  Send it with:    lm commit -t {thread.name}\n"
            f"  Discard it with: lm clear -t {thread.name}"
        )


# --- exchanges


@dataclass(frozen=True)
class _Exchange:
    """The files of one prompt, which a query and the turn it becomes share."""

    path: Path

    @property
    def prompt_path(self) -> Path:
        return self.path / "prompt.md"

    @property
    def stdin_path(self) -> Path:
        return self.path / "stdin"

    @property
    def attachments_path(self) -> Path:
        return self.path / "attachments"


@dataclass(frozen=True)
class _Query(_Exchange):
    """Staged, not sent yet."""


@dataclass(frozen=True)
class _Turn(_Exchange):
    """Sent, with the response saved beside it."""

    @property
    def response_path(self) -> Path:
        return self.path / "response.md"


def _write_prompt(prompt_path: Path, prompt: str) -> None:
    # new line at the end to be in line with response and stick to best practices
    prompt_path.write_text(f"{prompt}\n")


def _commit_staged(thread: _Thread, response: str) -> None:
    turn = _Turn(thread.get_turn_path(_get_turns_count(thread)))

    thread.staged_path.rename(turn.path)

    for path in turn.path.rglob("*"):
        if path.is_file():
            path.chmod(0o444)

    _write_read_only(turn.response_path, response)


def _remove_query(query: _Query) -> None:
    query.prompt_path.unlink(missing_ok=True)
    query.stdin_path.unlink(missing_ok=True)
    _remove_attachments(query.attachments_path)
    query.path.rmdir()


def _remove_turn(turn: _Turn) -> None:
    turn.prompt_path.unlink()
    turn.response_path.unlink()

    turn.stdin_path.unlink(missing_ok=True)
    _remove_attachments(turn.attachments_path)

    turn.path.rmdir()


def _remove_attachments(attachments_path: Path) -> None:
    if not attachments_path.exists():
        return

    for attachment_path in attachments_path.iterdir():
        attachment_path.unlink()
    attachments_path.rmdir()


# --- attachments


@dataclass(frozen=True)
class _Attachment:
    """A file attached to a query."""

    source_path: Path
    alias: str


def _get_attachments(args: list[str]) -> list[_Attachment]:
    attachments: list[_Attachment] = []
    for arg in args:
        if ":" not in arg:
            source_path = Path(arg)
            alias = source_path.name
        else:
            source_path_str, alias = arg.rsplit(":", 1)
            source_path = Path(source_path_str)
        if alias == "":
            sys.exit(f"Attachment alias is empty: {arg}")
        if not source_path.exists():
            sys.exit(f"Attachment not found: {source_path}")
        if source_path.is_dir():
            sys.exit(f"Attachment is a directory: {source_path}")
        if source_path.stat().st_size > ATTACHMENT_MAX_SIZE_BYTES:
            sys.exit(f"Attachment too large: {source_path}")
        if any(attachment.alias == alias for attachment in attachments):
            sys.exit(f"Attachment alias given twice: {alias}")
        attachments.append(_Attachment(source_path=source_path, alias=alias))
    return attachments


def _write_attachments(attachments: list[_Attachment], attachments_path: Path) -> None:
    for attachment in attachments:
        attachment.source_path.copy(attachments_path / attachment.alias)


# --- prompts and history


@dataclass(frozen=True)
class _HistoryEntry:
    """One past exchange, as the editor shows it back."""

    prompt: str
    attachment_names: tuple[str, ...]
    response: str


class _EmptyPromptError(Exception):
    """The editor came back with nothing."""


def _edit_prompt(
    editmsg_path: Path,
    *,
    history: list[_HistoryEntry],
    draft: str | None,
    editor: str,
    tty_path: Path,
) -> str:
    editor_command = shlex.split(editor)
    if len(editor_command) == 0:
        sys.exit("Editor is empty.")

    editor_name = Path(editor_command[0]).name

    prompt_is_last = editor_name in PROMPT_IS_LAST_EDITORS

    if prompt_is_last:
        editor_command.append("+$")
        scissors_line_component = (
            "<!-- Everything above this scissors line will be ignored. -->\n"
            f"{SCISSORS_LINE}\n"
        )
    else:
        scissors_line_component = (
            f"{SCISSORS_LINE}\n"
            "<!-- Everything below this scissors line will be ignored. -->\n"
        )

    if editor_name in INSERT_MODE_EDITORS and draft is None:
        # Immediately open in insert mode, pressing 'i' adds real friction!
        editor_command.append("+startinsert")

    components: list[str] = []

    components.extend(_format_history(history))

    if len(components) > 0:
        components.append(scissors_line_component)

    if draft is not None:
        components.append(draft)
    else:
        # drafts come with trailing newline, add it to empty string for consistency
        components.append("\n")

    if not prompt_is_last:
        components.reverse()

    editmsg_path.write_text("\n\n".join(components))

    # lm's own stdin and stdout may be pipes (`cat foo | lm run | less`), and the
    # editor needs the terminal
    with tty_path.open("r") as tty_in, tty_path.open("w") as tty_out:
        process_result = subprocess.run(  # noqa: S603  (running the user editor expected to be safe)
            [*editor_command, str(editmsg_path)],
            check=False,
            stdin=tty_in,
            stdout=tty_out,
            stderr=tty_out,
        )

    if process_result.returncode != 0:
        sys.exit("Editor exited with an error.")

    editmsg_fragments = editmsg_path.read_text().split(f"\n{SCISSORS_LINE}\n")
    editmsg_path.unlink()

    prompt_fragment = editmsg_fragments[-1] if prompt_is_last else editmsg_fragments[0]
    prompt = prompt_fragment.strip()

    if prompt == "":
        raise _EmptyPromptError

    return prompt


def _format_history(history: list[_HistoryEntry]) -> list[str]:
    components: list[str] = []
    for index, entry in enumerate(history):
        prompt_component = f"<!-- Prompt {index + 1} -->\n\n{entry.prompt}"
        if len(entry.attachment_names) > 0:
            prompt_component += f"\nAttachments: {', '.join(entry.attachment_names)}"
        response_component = f"<!-- Answer {index + 1} -->\n\n{entry.response}"

        components.append(prompt_component)
        components.append(response_component)
    return components


def _build_history(thread: _Thread) -> list[_HistoryEntry]:
    entries: list[_HistoryEntry] = []
    turns_count = _get_turns_count(thread)
    for index in range(turns_count):
        turn = _Turn(thread.get_turn_path(index))
        attachments_path = turn.attachments_path
        if attachments_path.exists():
            attachment_names = tuple(path.name for path in attachments_path.iterdir())
        else:
            attachment_names = ()
        prompt = turn.prompt_path.read_text()
        response = turn.response_path.read_text()
        entries.append(
            _HistoryEntry(
                prompt=prompt, attachment_names=attachment_names, response=response
            )
        )
    return entries


# --- inference


def _handle_turn(
    thread: _Thread,
    *,
    prompt: str,
    piped_stdin: str,
    attachments_path: Path | None,
    char_delay_seconds: float,
    claude_projects_path: Path,
) -> str:
    prompt_summary = _summarize_text(prompt, max_length=PROMPT_SUMMARY_MAX_LENGTH)
    claude_model = thread.model_path.read_text()
    claude_effort = thread.effort_path.read_text()
    claude_system_prompt = thread.system_prompt_path.read_text()
    claude_tools = thread.tools_path.read_text()

    with _ClaudeContext.create(
        projects_path=claude_projects_path,
        thread_session_path=thread.session_path,
        thread_session_lines_path=thread.session_lines_path,
        scratch_cwd_path=thread.scratch_cwd_path,
        attachments_path=attachments_path,
    ) as references:
        claude_prompt = (
            prompt
            if references.attachments_prompt is None
            else f"{prompt}\n\n{references.attachments_prompt}"
        )

        command = [
            "claude",
            "--model",
            claude_model,
            "--effort",
            claude_effort,
            "--system-prompt",
            claude_system_prompt,
            *references.session_args,
            # Non-interactive: one turn, then exit
            "--print",
            # Keeps user config out but still logs in with the subscription;
            # --bare never reads OAuth credentials and needs an API key instead
            # Ref: https://code.claude.com/docs/en/cli-reference#cli-flags
            # Ref: https://code.claude.com/docs/en/headless#start-faster-with-bare-mode
            "--safe-mode",
            # Only the thread's capabilities, so no tool can reach the disk
            "--tools",
            claude_tools,
            # Pre-approve to avoid permission errors in print mode
            "--allowed-tools",
            claude_tools,
            # Without it, text arrives only once each message is whole
            "--include-partial-messages",
            "--output-format",
            "stream-json",
            # claude refuses stream-json in print mode without it
            "--verbose",
            # A prompt starting with a hyphen would otherwise be read as an option
            "--",
            claude_prompt,
        ]

        # Claude keeps writing the session file after the result it ends on, and
        # leaving this block waits for it to finish before the file is moved.
        # Observed, not documented: the docs only say transcripts are saved
        # continuously.
        with subprocess.Popen(  # noqa: S603  (command is not user-provided)
            command,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            text=True,
            # Nothing from the directory lm was run reaches, and the attachments
            # are linked in here for @ references to work
            cwd=thread.scratch_cwd_path,
        ) as process:
            if process.stdin is None:
                sys.exit("Unexpected error: Claude standard input not captured")

            process.stdin.write(piped_stdin)
            process.stdin.close()

            # Clear screen, helps keeping text stationary as it streams.
            sys.stderr.write("\033[2J\033[H")
            sys.stderr.write(f"Running prompt: {prompt_summary}\n\n")
            sys.stderr.flush()

            return _read_response(
                process, thread_name=thread.name, char_delay_seconds=char_delay_seconds
            )


def _read_response(
    process: subprocess.Popen[str], *, thread_name: str, char_delay_seconds: float
) -> str:
    if process.stdout is None:
        sys.exit("Unexpected error: Claude standard output not captured")

    stream = _ResponseStream(char_delay_seconds=char_delay_seconds)
    for line in process.stdout:
        try:
            events = _ClaudeOutput.parse_line(line)
        except _ClaudeOutput.UnreadableEventError as error:
            sys.exit(
                _format_inference_failure(detail=str(error), thread_name=thread_name)
            )

        for event in events:
            match event:
                case _ClaudeOutput.TextDelta(text=text):
                    stream.write_text(text)
                case _ClaudeOutput.ToolCall(name=name, arguments=arguments):
                    stream.write_tool_call(_format_tool_call(name, arguments))
                case _ClaudeOutput.Compaction(pre_tokens=pre_tokens):
                    stream.write_notice(f"Compacted session at {pre_tokens} tokens")
                case _ClaudeOutput.Success():
                    stream.end()
                    return stream.get_text()
                case _ClaudeOutput.Failure(errors=errors, subtype=subtype):
                    detail = _get_failure_detail(errors=errors, error_subtype=subtype)
                    sys.exit(
                        _format_inference_failure(
                            detail=detail, thread_name=thread_name
                        )
                    )
                case _:
                    assert_never(event)

    # Every result event returns or exits, so the stream ended without one.
    process.wait()
    sys.exit(
        _format_inference_failure(
            detail=f"claude exited {process.returncode} without reporting a result",
            thread_name=thread_name,
        )
    )


class _ClaudeOutput:
    """The events claude prints during a turn, as far as lm reads them."""

    @dataclass(frozen=True)
    class TextDelta:
        """The next piece of the response text."""

        text: str

    @dataclass(frozen=True)
    class ToolCall:
        """A tool claude ran during the turn."""

        name: str
        # Whatever the tool takes, so the keys are the tool's rather than ours
        arguments: Mapping[str, object]

    @dataclass(frozen=True)
    class Compaction:
        """Claude summarizing the history of the session."""

        pre_tokens: int

    @dataclass(frozen=True)
    class Success:
        """The end of a turn that worked."""

    @dataclass(frozen=True)
    class Failure:
        """The end of a turn that failed."""

        errors: tuple[str, ...]
        subtype: str | None

    type Event = TextDelta | ToolCall | Compaction | Success | Failure

    class UnreadableEventError(Exception):
        """An event lm reads, in a shape lm cannot read."""

    @staticmethod
    def parse_line(line: str) -> tuple[_ClaudeOutput.Event, ...]:
        event = json.loads(line)
        match event:
            # The result event ends the run, and its is_error says whether the
            # turn succeeded.
            # Ref: https://code.claude.com/docs/en/agent-sdk/typescript#sdkresultmessage
            case {"type": "result", "is_error": False}:
                return (_ClaudeOutput.Success(),)
            case {"type": "result", "is_error": True}:
                errors = event.get("errors", [])
                subtype = event.get("subtype")
                if not isinstance(errors, list) or not all(
                    isinstance(error, str) for error in errors
                ):
                    message = f"claude sent errors that are not text: {errors}"
                    raise _ClaudeOutput.UnreadableEventError(message)
                if subtype is not None and not isinstance(subtype, str):
                    message = f"claude sent a subtype that is not text: {subtype}"
                    raise _ClaudeOutput.UnreadableEventError(message)
                return (_ClaudeOutput.Failure(errors=tuple(errors), subtype=subtype),)
            # Claude summarizes the history once it grows too long. The turns on
            # disk still hold every exchange, but it stops sending them all.
            case {
                "type": "system",
                "subtype": "compact_boundary",
                "compact_metadata": {"pre_tokens": int(pre_tokens)},
            }:
                return (_ClaudeOutput.Compaction(pre_tokens=pre_tokens),)
            # Claude reports each block of a message once it is whole, so a
            # complete tool call arrives in one piece.
            case {"type": "assistant", "message": {"content": [*content_blocks]}}:
                calls: list[_ClaudeOutput.Event] = []
                for content_block in content_blocks:
                    match content_block:
                        case {
                            "type": "tool_use",
                            "name": str(name),
                            "input": dict(arguments),
                        }:
                            call = _ClaudeOutput.ToolCall(
                                name=name, arguments=arguments
                            )
                            calls.append(call)
                        case {"type": "tool_use"}:
                            message = (
                                "claude sent a tool call lm cannot read: "
                                f"{content_block}"
                            )
                            raise _ClaudeOutput.UnreadableEventError(message)
                        # Text and thinking arrive as deltas instead
                        case _:
                            pass
                return tuple(calls)
            case {
                "type": "stream_event",
                "event": {
                    "type": "content_block_delta",
                    "delta": {"type": "text_delta", "text": str(text)},
                },
            }:
                return (_ClaudeOutput.TextDelta(text=text),)
            case (
                {"type": "result" | "assistant"}
                | {"type": "system", "subtype": "compact_boundary"}
                | {
                    "type": "stream_event",
                    "event": {
                        "type": "content_block_delta",
                        "delta": {"type": "text_delta"},
                    },
                }
            ):
                message = f"claude sent a {event['type']} event lm cannot read"
                raise _ClaudeOutput.UnreadableEventError(message)
            # Claude streams more kinds of events than a turn needs
            case _:
                return ()


def _get_failure_detail(*, errors: tuple[str, ...], error_subtype: str | None) -> str:
    if len(errors) > 0:
        return "; ".join(errors)
    if error_subtype is None:
        return "error result with no subtype"
    description = CLAUDE_ERROR_SUBTYPE_REASONS.get(error_subtype, "unknown error")
    return f"{description} ({error_subtype})"


def _format_inference_failure(*, detail: str, thread_name: str) -> str:
    return (
        f"Inference failed: {detail}.\n"
        "Your query is still staged.\n"
        f"  Retry with:      lm commit -t {thread_name}\n"
        f"  Discard it with: lm clear -t {thread_name}"
    )


def _format_tool_call(name: str, arguments: Mapping[str, object]) -> str:
    formatted_arguments: list[str] = []
    for argument, value in arguments.items():
        summary = _summarize_text(
            json.dumps(value), max_length=TOOL_ARGUMENT_MAX_LENGTH
        )
        formatted_arguments.append(f"{argument}={summary}")
    return f"{name}({', '.join(formatted_arguments)})"


class _ResponseStream:
    """The response as it arrives, written out one paragraph at a time."""

    def __init__(self, char_delay_seconds: float) -> None:
        self._char_delay_seconds = char_delay_seconds
        self._chunks: list[str] = []
        self._is_paragraph_closed = False

    def write_text(self, text: str) -> None:
        if self._is_paragraph_closed:
            self._write("\n\n")
            self._is_paragraph_closed = False
        self._write(text)

    def write_tool_call(self, call: str) -> None:
        """Say in the response that a tool is running."""
        self._break_paragraph()
        self._write(f"> Running tool: {call}")
        self._is_paragraph_closed = True

    def write_notice(self, notice: str) -> None:
        """Report on stderr what happened to the session."""
        self._break_paragraph()
        sys.stderr.write(f"{notice}\n\n")
        sys.stderr.flush()

    def end(self) -> None:
        self._write("\n")

    def get_text(self) -> str:
        return "".join(self._chunks)

    def _break_paragraph(self) -> None:
        if len(self._chunks) > 0:
            self._write("\n\n")
        self._is_paragraph_closed = False

    def _write(self, text: str) -> None:
        self._chunks.append(text)

        if self._char_delay_seconds == 0.0:
            sys.stdout.write(text)
            sys.stdout.flush()
            return

        for char in text:
            sys.stdout.write(char)
            sys.stdout.flush()
            time.sleep(self._char_delay_seconds)


@dataclass(frozen=True)
class _ClaudeReferences:
    """What claude needs to find the context of a turn."""

    session_args: tuple[str, ...]
    attachments_prompt: str | None


class _ClaudeContext:
    def __init__(
        self,
        session_id: str,
        thread_session_path: Path,
        thread_session_lines_path: Path,
        turn_lines_counts: tuple[int, ...],
        claude_session_path: Path,
        scratch_cwd_path: Path,
        attachments_path: Path | None,
    ) -> None:
        self._session_id = session_id
        self._thread_session_path = thread_session_path
        self._thread_session_lines_path = thread_session_lines_path
        self._turn_lines_counts = turn_lines_counts
        self._claude_session_path = claude_session_path
        self._scratch_cwd_path = scratch_cwd_path
        self._attachments_path = attachments_path

    @staticmethod
    def create(
        *,
        projects_path: Path,
        thread_session_path: Path,
        thread_session_lines_path: Path,
        scratch_cwd_path: Path,
        attachments_path: Path | None,
    ) -> _ClaudeContext:
        # Ref: https://code.claude.com/docs/en/sessions#where-transcripts-are-stored
        escaped_cwd = re.sub(r"[^a-zA-Z0-9]", "-", str(scratch_cwd_path.resolve()))
        project_path = projects_path / escaped_cwd
        id_ = str(uuid.uuid4())
        claude_session_path = project_path / f"{id_}.jsonl"
        turn_lines_counts = _get_turn_lines_counts(thread_session_lines_path)
        return _ClaudeContext(
            id_,
            thread_session_path,
            thread_session_lines_path,
            turn_lines_counts,
            claude_session_path,
            scratch_cwd_path,
            attachments_path,
        )

    def __enter__(self) -> _ClaudeReferences:
        self._projects_path.mkdir(parents=True, exist_ok=True)
        self._project_path.mkdir()

        if len(self._turn_lines_counts) == 0:
            flag = "--session-id"
        else:
            flag = "--resume"
            self._claude_session_path.symlink_to(self._thread_session_path.resolve())

        if self._attachments_path is None:
            attachments_prompt = None
        else:
            attachments_prompt_lines = ["Attached files:"]
            for source_path in self._attachments_path.iterdir():
                link_path = self._scratch_cwd_path / source_path.name
                link_path.symlink_to(
                    source_path.resolve().relative_to(
                        self._scratch_cwd_path.resolve(), walk_up=True
                    )
                )
                attachments_prompt_lines.append(f"- @{link_path.name}")
            attachments_prompt = "\n".join(attachments_prompt_lines)

        return _ClaudeReferences(
            session_args=(flag, self._session_id),
            attachments_prompt=attachments_prompt,
        )

    def __exit__(
        self,
        exception_type: type[BaseException] | None,
        exception: BaseException | None,
        traceback: TracebackType | None,
    ) -> None:
        if self._claude_session_path.is_symlink():
            self._claude_session_path.unlink()
        elif self._claude_session_path.exists():
            self._claude_session_path.rename(self._thread_session_path)

        self._project_path.rmdir()

        for path in self._scratch_cwd_path.iterdir():
            path.unlink()

        if exception_type is None:
            lines_count = self._thread_session_path.read_text().count("\n")
            added_lines_count = lines_count - sum(self._turn_lines_counts)
            _write_turn_lines_counts(
                self._thread_session_lines_path,
                (*self._turn_lines_counts, added_lines_count),
            )
        else:
            # Otherwise the retry would send the failed prompt a second time
            _truncate_session(self._thread_session_path, self._turn_lines_counts)

    @property
    def _project_path(self) -> Path:
        return self._claude_session_path.parent

    @property
    def _projects_path(self) -> Path:
        return self._project_path.parent


# --- output


def _write_paged(content: str, *, pager: str) -> None:
    if not sys.stdout.isatty():
        sys.stdout.write(content)
        return

    pager_env = os.environ.copy()
    # A short output prints and exits like cat does, and stays on screen after
    # less quits: --quit-if-one-screen --RAW-CONTROL-CHARS --no-init
    pager_env.setdefault("LESS", "-FRX")
    with subprocess.Popen(  # noqa: S603  (running the user pager expected to be safe)
        pager,
        stdin=subprocess.PIPE,
        text=True,
        env=pager_env,
    ) as pager_process:
        if pager_process.stdin is None:
            sys.exit("Unexpected error: Pager standard input not captured")
        pager_process.stdin.write(content)


def _format_thread_summary_line(thread: _Thread) -> str:
    name = _compress_text(thread.name, max_length=LS_NAME_LENGTH)
    turns_count = _get_turns_count(thread)

    header = f"{name:<{LS_NAME_LENGTH}}   {turns_count:{LS_TURNS_COUNT_WIDTH}d}t"
    if turns_count == 0:
        return header

    last_turn = _Turn(thread.get_turn_path(turns_count - 1))
    prompt = _summarize_text(
        last_turn.prompt_path.read_text(), max_length=LS_PROMPT_LENGTH
    )
    response = _summarize_text(
        last_turn.response_path.read_text(), max_length=LS_RESPONSE_LENGTH
    )

    return f"{header}   {prompt:<{LS_PROMPT_LENGTH}}   {response:<{LS_RESPONSE_LENGTH}}"


def _format_status(thread: _Thread) -> str:
    system_prompt = _summarize_text(
        thread.system_prompt_path.read_text(), max_length=PROMPT_SUMMARY_MAX_LENGTH
    )
    claude_tools = thread.tools_path.read_text()
    tools = "none" if claude_tools == "" else ", ".join(claude_tools.split(","))
    model = thread.model_path.read_text()
    effort = thread.effort_path.read_text()
    turns_count = _get_turns_count(thread)

    lines = [
        f"{'Thread:':<{STATUS_LABEL_WIDTH}}{thread.name}",
        f"{'Model:':<{STATUS_LABEL_WIDTH}}{model}",
        f"{'Effort:':<{STATUS_LABEL_WIDTH}}{effort}",
        f"{'System:':<{STATUS_LABEL_WIDTH}}{system_prompt}",
        f"{'Tools:':<{STATUS_LABEL_WIDTH}}{tools}",
        f"{'Turns:':<{STATUS_LABEL_WIDTH}}{turns_count}",
        "",
    ]

    staged = _Query(thread.staged_path)
    if not staged.path.exists():
        lines.append("Nothing staged.")
        return "\n".join(lines) + "\n"

    staged_lines = _format_staged(staged)
    # The staged directory is created before anything is written into it
    if len(staged_lines) == 0:
        lines.append("Staged: empty.")
        return "\n".join(lines) + "\n"

    lines.append("Staged:")
    lines.extend(staged_lines)

    return "\n".join(lines) + "\n"


def _format_staged(staged: _Query) -> list[str]:
    lines: list[str] = []

    prompt_path = staged.prompt_path
    if prompt_path.exists():
        prompt = _summarize_text(
            prompt_path.read_text(), max_length=PROMPT_SUMMARY_MAX_LENGTH
        )
        lines.append(f"  {'prompt':<{STATUS_STAGED_LABEL_WIDTH}}{prompt}")

    stdin_path = staged.stdin_path
    if stdin_path.exists():
        lines_count = len(stdin_path.read_text().splitlines())
        plural = "" if lines_count == 1 else "s"
        lines.append(
            f"  {'stdin':<{STATUS_STAGED_LABEL_WIDTH}}{lines_count} line{plural}"
        )

    attachments_path = staged.attachments_path
    if attachments_path.exists():
        names = sorted(path.name for path in attachments_path.iterdir())
        lines.append(
            f"  {'attachments':<{STATUS_STAGED_LABEL_WIDTH}}{', '.join(names)}"
        )

    return lines


def _summarize_text(value: str, *, max_length: int) -> str:
    return _compress_text(" ".join(value.split()), max_length=max_length)


def _compress_text(value: str, max_length: int) -> str:
    if len(value) <= max_length:
        return value
    left = max_length // 2
    right = max_length - left - 3
    return f"{value[:left]}...{value[-right:]}"


