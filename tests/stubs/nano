#!/usr/bin/env python3
"""Stand-in for nano: writes the prompt above the scissors line."""

import sys
from pathlib import Path

import editing


def main() -> None:
    """Record the buffer lm built, then type the next prompt into its half."""
    buffer_path = Path(sys.argv[-1])
    buffer = buffer_path.read_text()
    editing.record_call(buffer, argv=sys.argv[1:-1])

    fragments = buffer.split(editing.SCISSORS_SEPARATOR)
    fragments[0] += "\n" + editing.take_prompt()
    buffer_path.write_text(editing.SCISSORS_SEPARATOR.join(fragments))


if __name__ == "__main__":
    main()
