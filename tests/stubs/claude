#!/usr/bin/env python3
"""Stand-in for the claude CLI: records the call and replays a canned response."""

import json
import os
import sys
from pathlib import Path

from protocol import CLAUDE_ARGV_ENV, CLAUDE_RESPONSE_ENV, CLAUDE_STDIN_ENV


def main() -> None:
    """Record the call lm made, then replay the canned response."""
    Path(os.environ[CLAUDE_ARGV_ENV]).write_text("\n".join(sys.argv[1:]))
    Path(os.environ[CLAUDE_STDIN_ENV]).write_text(sys.stdin.read())

    response = Path(os.environ[CLAUDE_RESPONSE_ENV]).read_text()
    event = {
        "type": "stream_event",
        "event": {
            "type": "content_block_delta",
            "delta": {"type": "text_delta", "text": response},
        },
    }
    sys.stdout.write(json.dumps(event) + "\n")


if __name__ == "__main__":
    main()
