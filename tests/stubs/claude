#!/usr/bin/env python3
"""Stand-in for the claude CLI: records the call and plays the scripted run."""

import json
import os
import re
import sys
from pathlib import Path
from typing import assert_never

from protocol import (
    CLAUDE_ARGV_ENV,
    CLAUDE_SCRIPT_ENV,
    CLAUDE_SESSION_ENV,
    CLAUDE_STDIN_ENV,
    ClaudeCompaction,
    ClaudeError,
    ClaudeRawLine,
    ClaudeScript,
    ClaudeSuccess,
    ClaudeText,
    ClaudeToolCall,
    SessionTurn,
)

ERROR_RETURNCODE = 1


def main() -> None:
    """Record the call lm made, then play the one run the test scripted."""
    prompt = sys.argv[sys.argv.index("--") + 1]
    Path(os.environ[CLAUDE_ARGV_ENV]).write_text(json.dumps(sys.argv[1:]))
    Path(os.environ[CLAUDE_STDIN_ENV]).write_text(sys.stdin.read())

    if "--session-id" in sys.argv:
        session_id = sys.argv[sys.argv.index("--session-id") + 1]
    elif "--resume" in sys.argv:
        session_id = sys.argv[sys.argv.index("--resume") + 1]
    else:
        sys.exit("Expected --session-id or --resume in the claude call")

    # Mirrors how claude names the directory it keeps a project's sessions in,
    # so the turn only lands in the thread if lm predicted the same path
    project_name = re.sub(r"[^a-zA-Z0-9]", "-", str(Path.cwd()))
    project_path = Path.home() / ".claude" / "projects" / project_name
    session_path = project_path / f"{session_id}.jsonl"

    if "--resume" in sys.argv and not session_path.exists():
        sys.exit(f"No conversation found with session ID: {session_id}")

    script = ClaudeScript.from_json(Path(os.environ[CLAUDE_SCRIPT_ENV]).read_text())

    for event in script.events:
        match event:
            case ClaudeText(text=event_text):
                if event_text != "":
                    _write_text_event(event_text)
            case ClaudeToolCall(name=name, arguments=arguments):
                _write_tool_call_event(name, arguments)
            case ClaudeCompaction(pre_tokens=pre_tokens):
                _write_compaction_event(pre_tokens)
            case ClaudeRawLine(line=line):
                sys.stdout.write(line + "\n")
                sys.stdout.flush()
            case _:
                assert_never(event)

    match script.ending:
        case ClaudeSuccess():
            _write_event({"type": "result", "subtype": "success", "is_error": False})
            _wait_for_caller_to_stop_reading()
            returncode = 0
        case ClaudeError(subtype=subtype, errors=errors):
            _write_event(
                {
                    "type": "result",
                    "subtype": subtype,
                    "is_error": True,
                    "errors": errors,
                }
            )
            _wait_for_caller_to_stop_reading()
            returncode = ERROR_RETURNCODE
        case None:
            returncode = 0
        case _:
            assert_never(script.ending)

    project_path.mkdir(parents=True, exist_ok=True)
    with session_path.open("a") as session_file:
        session_file.write(SessionTurn(prompt=prompt).to_line())

    lines = session_path.read_text().splitlines()
    prompts = [SessionTurn.from_line(line).prompt for line in lines]
    Path(os.environ[CLAUDE_SESSION_ENV]).write_text(json.dumps(prompts))

    sys.exit(returncode)


def _wait_for_caller_to_stop_reading() -> None:
    """Write filler to stdout until caller closes it."""
    # Claude writes the last of the session after the result, so the stub holds
    # that write until lm is done with the run. Once lm stops reading, the pipe
    # fills up and the next write waits, until lm closes the pipe.
    # Ref: https://man7.org/linux/man-pages/man7/pipe.7.html
    # This relies on lm never parsing past the result, and on lm closing the pipe
    # right before it waits for claude to exit, as leaving a Popen block does. The
    # stub cannot see lm waiting for it, so closing the pipe is the closest signal
    # it has: an lm that closed the pipe and then slept instead of waiting would
    # still pass.
    try:
        while True:
            os.write(sys.stdout.fileno(), b"\n" * 4096)
    except BrokenPipeError:
        pass


def _write_tool_call_event(name: str, arguments: dict[str, object]) -> None:
    """Report the call the way claude does, as a block of a finished message."""
    _write_event(
        {
            "type": "assistant",
            "message": {
                "content": [{"type": "tool_use", "name": name, "input": arguments}]
            },
        }
    )


def _write_compaction_event(pre_tokens: int) -> None:
    _write_event(
        {
            "type": "system",
            "subtype": "compact_boundary",
            "compact_metadata": {"trigger": "auto", "pre_tokens": pre_tokens},
        }
    )


def _write_text_event(text: str) -> None:
    _write_event(
        {
            "type": "stream_event",
            "event": {
                "type": "content_block_delta",
                "delta": {"type": "text_delta", "text": text},
            },
        }
    )


def _write_event(event: dict[str, object]) -> None:
    sys.stdout.write(json.dumps(event) + "\n")
    sys.stdout.flush()


if __name__ == "__main__":
    main()
